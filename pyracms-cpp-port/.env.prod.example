# Copy to .env.prod (git-ignored), fill in, chmod 600, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.prod -p pyracms-prod up -d --build
# Generate strong values with ./scripts/gen-env.sh > .env.prod
# NEVER commit .env.prod.   Full guide: docs/DEPLOY.md

# --- required (compose refuses to start without them) ---
POSTGRES_PASSWORD=
JWT_SECRET=

# --- public origin, NO trailing slash (used for e-mail links, the CORS
#     allow-list, sitemap/robots and Open Graph tags) ---
SITE_URL=https://cms.example.com
# CORS_ALLOWED_ORIGINS=https://cms.example.com,https://www.example.com

# --- optional ---
POSTGRES_USER=pyracms
POSTGRES_DB=pyracms
NGINX_BIND=127.0.0.1
NGINX_PORT=3199
# PYRACMS_VERSION=1.2.3   # docker-compose.ghcr.yml only: pin a release

# --- first run: create the Platform Owner (only while no platform account
#     exists; REMOVE these three lines after the first start) ---
# ADMIN_USERNAME=owner
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=

# --- SMTP (password reset / verification). Test: scripts/test-mail.sh ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587            # 587 STARTTLS, 465 implicit TLS
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=PyraCMS <noreply@example.com>

# --- OAuth: put these in a separate optional file .env.oauth (git-ignored),
#     NOT here (the server treats empty values as "configured"):
#   OAUTH_GITHUB_CLIENT_ID=... OAUTH_GITHUB_CLIENT_SECRET=...
#   OAUTH_GITHUB_REDIRECT_URI=https://cms.example.com/auth/callback/github
#   (same for GOOGLE / DISCORD; the redirect default is localhost:3000!)

# --- backups (compose profile `backup` and scripts/backup.sh) ---
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
# BACKUP_INTERVAL_H=24

# --- uploaded-file storage (docs/STORAGE.md) ---
# STORAGE_BACKEND=s3               # production: s3 only (local is refused)
# MAX_CHUNKED_UPLOAD_MB=1024       # largest chunked (archive) upload
# S3_BUCKET=pyracms
# S3_ACCESS_KEY=...                # scripts/gen-env.sh generates these
# S3_SECRET_KEY=...
# OBJECTSTORE_REMOVE_SEED=1        # drop the store's built-in minioadmin key
