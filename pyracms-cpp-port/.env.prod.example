# Copy to .env.prod (git-ignored), fill in, chmod 600, then:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.prod -p pyracms-prod up -d --build
# Generate strong values with ./scripts/gen-env.sh > .env.prod
# NEVER commit .env.prod.

# --- required (compose refuses to start without them) ---
POSTGRES_PASSWORD=
JWT_SECRET=

# --- optional ---
POSTGRES_USER=pyracms
POSTGRES_DB=pyracms
NGINX_BIND=127.0.0.1
NGINX_PORT=3199
# PYRACMS_VERSION=1.2.3   # docker-compose.ghcr.yml only: pin a release

# OAuth / SMTP (only if used)
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
